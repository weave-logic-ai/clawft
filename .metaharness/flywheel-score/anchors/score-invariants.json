{
  "id": "weftos-score-invariants",
  "kind": "score_flywheel_anchor",
  "mode": "evaluate_only",
  "invariants": [
    {
      "id": "foundation_ge_80",
      "check": "weftosFoundationScore >= 80",
      "source": ".metaharness/weftos-score-latest.json"
    },
    {
      "id": "tasks_ge_3",
      "check": "components.tasks >= 3"
    },
    {
      "id": "views_ge_1",
      "check": "components.views >= 1"
    },
    {
      "id": "patterns_ge_5",
      "check": "components.patternsManifest >= 5"
    },
    {
      "id": "compile_100",
      "check": "upstream compileConfidence == 100 when score-latest present"
    },
    {
      "id": "workspace_members_ge_20",
      "check": "components.workspaceMembers >= 20"
    },
    {
      "id": "dist_targets_ge_5",
      "check": "components.distTargetCount >= 5"
    },
    {
      "id": "domains_hit_ge_4",
      "check": "components.domainsHit >= 4"
    },
    {
      "id": "genome_publish_ready",
      "check": "upstreamGenome.publish_readiness >= 0.8 when genome present"
    },
    {
      "id": "no_silent_gate_relax",
      "check": "scripts/build.sh gate still listed as task weft-gate command"
    }
  ],
  "regressed_if": [
    "weftosFoundationScore drops vs previous weftos-score-latest.json without receipt",
    "validate-views fails",
    "ADR-090 predicates removed",
    "workspaceMembers or distTargetCount collapse (OS surface regression)"
  ]
}
