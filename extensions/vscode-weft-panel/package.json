{
  "name": "vscode-weft-panel",
  "displayName": "WeftOS Dev Panel",
  "description": "M0 dev-panel: proves the daemon <-> extension <-> webview loop for WeftOS.",
  "version": "0.0.1",
  "publisher": "weavelogic",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:weft.openPanel",
    "onWebviewPanel:weft.panel"
  ],
  "contributes": {
    "commands": [
      {
        "command": "weft.openPanel",
        "title": "WeftOS: Open Panel",
        "category": "WeftOS"
      }
    ],
    "configuration": {
      "title": "WeftOS",
      "properties": {
        "weft.multiUser": {
          "type": "boolean",
          "default": false,
          "description": "Enable multi-user panel auth (WEFT-495 / ADR-071). When true, each panel gets a scoped host-held token and methods outside those scopes are denied by identity. Also enabled by WEFTOS_MULTI_USER=1."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "compile-tests": "tsc -p test/",
    "watch": "tsc -w -p .",
    "package": "vsce package --allow-missing-repository",
    "pretest": "npm run compile && npm run compile-tests",
    "test": "node ./out-test/runTest.js",
    "test:panel-auth": "npm run compile && node scripts/test-panel-auth.mjs",
    "test:chip-a11y": "npx --yes tsx --test src/chipA11y.test.ts",
    "test:active-radar": "npx --yes tsx --test src/activeRadar.test.ts",
    "test:wsp": "npx --yes tsx --test src/wsp.test.ts",
    "test:capture": "npx --yes tsx --test src/captureSidecar.test.ts",
    "test:unit": "npm run test:panel-auth && npm run test:chip-a11y && npm run test:wsp && npm run test:active-radar && npm run test:capture"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "glob": "^10.3.10",
    "mocha": "^10.4.0",
    "typescript": "^5.4.0"
  }
}
